引导、立刃建立时机、前后刃重心转移的平顺性。", "cause_chain": "换刃后旋转引导不足，板头太早冲落线，弯前半段被剪短 → 控速和走线都来不及建立 → 下半段只能靠临时急转去补救 → 弯越做越仓促、越做越J型 → 速度和压力越积越多，每一步都在和时间赛跑。"}, "comparison": [{"text": "今天 62.9° vs 上个雪日 52.7°", "label": "最大立刃", "status": "better"}, {"text": "今天 133 vs 上个雪日 125", "label": "最佳 IQ", "status": "better"}], "sign_off_words": "今天的滑行，正在接近更好的自己"}, "run_list": [{"run_idx": 0, "iq": 107, "iq_details": {"flow": 122.4, "pressure": 97.9, "similarity": 96.6, "timing": 111.6}, "start_time": 1785891904.157, "start_time_hms": "13:05:04", "turn_count": 85, "max_edge_angle": 33.6, "max_speed": 49.8, "tempo": 27.0, "avg_radius": 11.18, "segment_count": 5, "locked": false, "headline": null, "headline_zh": null, "headline_en": null}, {"run_idx": 1, "iq": 110, "iq_details": {"flow": 124.8, "pressure": 101.1, "similarity": 97.2, "timing": 117.6}, "start_time": 1785892613.697, "start_time_hms": "13:16:53", "turn_count": 92, "max_edge_angle": 33.7, "max_speed": 27.5, "tempo": 32.0, "avg_radius": 9.95, "segment_count": 5, "locked": false, "headline": null, "headline_zh": null, "headline_en": null}, {"run_idx": 2, "iq": 133, "iq_details": {"flow": 144.7, "pressure": 128.6, "similarity": 116.6, "timing": 141.6}, "start_time": 1785893256.143, "start_time_hms": "13:27:36", "turn_count": 97, "max_edge_angle": 51.6, "max_speed": 49.8, "tempo": 26.0, "avg_radius": 9.09, "segment_count": 6, "locked": false, "headline": null, "headline_zh": null, "headline_en": null}, {"run_idx": 3, "iq": 125, "iq_details": {"flow": 135.9, "pressure": 120, "similarity": 106.5, "timing": 138.7}, "start_time": 1785893928.597, "start_time_hms": "13:38:48", "turn_count": 103, "max_edge_angle": 50.8, "max_speed": 24.3, "tempo": 28.0, "avg_radius": 9.36, "segment_count": 5, "locked": false, "headline": null, "headline_zh": null, "headline_en": null}, {"run_idx": 4, "iq": 131, "iq_details": {"flow": 146.8, "pressure": 124, "similarity": 116.9, "timing": 137.6}, "start_time": 1785895031.877, "start_time_hms": "13:57:11", "turn_coun